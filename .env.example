# Copia este archivo a .env. Nunca publiques claves reales.
OPENAI_API_KEY=
# Opcionales: si están vacías, se usa OPENAI_API_KEY.
LLM_API_KEY=
IMAGE_API_KEY=
TTS_API_KEY=
WHISPER_API_KEY=
LLM_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
# low | medium | high (solo modelos gpt-image). Más calidad = más coste.
IMAGE_QUALITY=medium
TTS_MODEL=tts-1
TTS_VOICE=nova
WHISPER_MODEL=whisper-1
# Chrome/Chromium instalado; vacío para descargar Chrome Headless Shell.
CHROME_EXECUTABLE=
RENDER_CONCURRENCY=2
# App web (npm start). Usa HOST=0.0.0.0 solo si quieres abrirla desde otro dispositivo de tu red.
PORT=3000
HOST=127.0.0.1
